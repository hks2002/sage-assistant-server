<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.da.sage.assistant.mapper.RoleMapper">
  <cache flushInterval="3600000" size="100" />
  <sql id="role_Query_WHERE">
    <choose>
      <when test="id != null and id != ''">
        id = #{id}
      </when> 
      <when test="role_code != null and role_code != ''">
        role_code = #{role_code}
      </when> 
      <when test="q != null and q != ''">
        role_code LIKE #{q}
        OR role_name LIKE #{q}
      </when> 
      <otherwise>
        1 = 1
      </otherwise>
    </choose>
  </sql>
  <sql id="role_Query_ORDER_BY">
    <if test="sortBy != null and sortBy != ''">
      ORDER BY
        <choose>
          <when test="sortBy == 'role_code'">
            role_code
          </when> 
          <when test="sortBy == 'role_name'">
            role_name
          </when> 
          <when test="sortBy == 'create_at'">
            create_at
          </when> 
          <when test="sortBy == 'update_at'">
            update_at
          </when> 
          <otherwise>
            id
          </otherwise>
        </choose> 
        <if test="descending != null and descending != ''">
          DESC
        </if>
    </if>
  </sql>
  <select id="role_Query">
    SELECT
      ROW_NUMBER() OVER () AS row_num,
      id,
      role_code,
      role_name,
      create_at,
      create_by,
      update_at,
      update_by
    FROM
      role
    WHERE
      <include refid="role_Query_WHERE"></include> 
      <include refid="role_Query_ORDER_BY"></include>
    LIMIT
      #{limit}
    OFFSET
      #{offset}
  </select>
  <select id="role_QueryCnt">
    SELECT
      count(1) AS total
    FROM
      role
    WHERE
      <include refid="role_Query_WHERE"></include>
  </select>
  <insert id="role_Insert">
    INSERT INTO
      role 
      <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="role_code != null">
          role_code,
        </if> 
        <if test="role_name != null">
          role_name,
        </if> 
        <if test="create_at != null">
          create_at,
        </if> 
        <if test="create_by != null">
          create_by,
        </if>
      </trim>
    VALUES
      <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="role_code != null">
          #{role_code},
        </if> 
        <if test="role_name != null">
          #{role_name},
        </if> 
        <if test="create_at != null">
          #{create_at},
        </if> 
        <if test="create_by != null">
          #{create_by},
        </if>
      </trim>
  </insert>
  <update id="role_Update">
    UPDATE role 
    <set>
      <if test="role_code != null">
        role_code = #{role_code},
      </if> 
      <if test="role_name != null">
        role_name = #{role_name},
      </if> 
      <if test="update_at != null">
        update_at = #{update_at},
      </if> 
      <if test="update_by != null">
        update_by = #{update_by},
      </if>
    </set>
    WHERE
      <choose>
        <when test="id != null and id != ''">
          id = #{id}
        </when> 
        <when test="role_code != null and role_code != ''">
          role_code = #{role_code}
        </when> 
        <otherwise>
          1 = 2
        </otherwise>
      </choose>
  </update>
  <delete id="user_Delete">
    DELETE FROM role
    WHERE
      <choose>
        <when test="id != null and id != ''">
          id = #{id}
        </when> 
        <when test="role_code != null and role_code != ''">
          role_code = #{role_code}
        </when> 
        <otherwise>
          1 = 2
        </otherwise>
      </choose>
  </delete>
</mapper>