{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.autobuild.enabled": true,
  "auto-header-plus.commentElements": [
    "Author",
    "CreatedDate",
    "LastEditors",
    "LastEditDate",
    "CopyRight"
  ],
  "auto-header-plus.commentElementsValue": {
    "CopyRight": "Dedienne Aerospace China ZhuHai"
  },
  "auto-header-plus.pathContainsWorkspaceFolder": false,
  "auto-header-plus.style.0": {
    "lineWidth": 120
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "[xml]": {
    "editor.formatOnSave": false
  },
  "xml.symbols.enabled": false,
  "chat.disableAIFeatures": true,
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  "editor.stickyTabStops": true,
  "editor.tabSize": 2,
  "editor.useTabStops": false,
  // for debug run
  "java.debug.settings.vmArgs": "-Dlog4j.skipJansi=false",
  // for unit test
  "java.test.config": {
    "vmArgs": [
      "-Dlog4j.skipJansi=false"
    ]
  },
  "java.jdt.ls.vmargs": "-Xmx1536m -Xms256m -Xlog:disable",
  "java.compile.nullAnalysis.mode": "disabled",
  "java.server.launchMode": "Standard",
  "trae.tab.enableRename": false,
  "trae.tab.enableAutoImport": false,
  "java.debug.settings.onBuildFailureProceed": true,
  "java.format.settings.url": ".vscode/java-formatter.xml",
}